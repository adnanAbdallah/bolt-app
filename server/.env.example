NODE_ENV=development
PORT=5001

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/bolt-moto

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:5001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SERVER_URL=http://localhost:5001
CLIENT_URL=http://localhost:5173

# Comma-separated emails that are promoted to admin on sign-in
ADMIN_EMAILS=

# Lets you sign in without Google while developing (never enabled in production)
ENABLE_DEV_LOGIN=true

# Fare settings
FARE_CURRENCY=USD
FARE_BASE=1.00
FARE_PER_KM=0.45
FARE_PER_MIN=0.08
FARE_MINIMUM=2.00

# Drivers need an approved license + insurance (reviewed in the admin dashboard) before going online
REQUIRE_DRIVER_VERIFICATION=true

# Dev only: demo drivers created by `npm run seed` drive around the admin Live Fleet map
SIMULATE_DEMO_FLEET=true

# --- Maps & location (Level 3) ---
# simulated: drivers step along routes with dev controls | gps: real device GPS only.
# Leave unset to use simulated in development and gps in production.
# LOCATION_MODE=simulated

# Default map centre and demo city ("lat,lng"). Set it to your own city for local testing.
MAP_CENTER=-1.2864,36.8172

# Address search: photon (OSM-based, allows type-ahead) or mock (offline)
GEOCODER=photon
GEOCODER_URL=https://photon.komoot.io

# Road routing: osrm or straight (offline straight-line estimate)
# The public OSRM demo server is for development only; use your own or a paid provider in production.
ROUTING=osrm
ROUTING_URL=https://router.project-osrm.org
# OSRM's car durations assume empty roads; multiply for city traffic (affects ETAs and the time part of fares).
ROUTE_DURATION_FACTOR=1.5

# Sent to the public OSM services, as their usage policies require. Include contact info in production.
GEO_USER_AGENT=BoltMotoDev/0.1 (local development)

# Map tiles. The public OSM tile server is for light development use only.
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
